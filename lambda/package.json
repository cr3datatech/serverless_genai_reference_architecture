{
  "name": "powerlab-genai-api-chat",
  "private": true,
  "description": "Lambda handler for the GenAI API: validates requests, resolves model aliases and calls the Bedrock Converse API.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc --noEmit && tsc -p tsconfig.build.json",
    "test": "tsc --noEmit && esbuild src/*.test.ts --bundle --platform=node --target=node22 --format=cjs --external:@aws-sdk/* --outdir=dist-test && node --test \"dist-test/*.test.js\""
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
