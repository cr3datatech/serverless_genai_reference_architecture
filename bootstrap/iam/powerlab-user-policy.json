{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeControlRolesWithMfa",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/control/powerlab-*",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
